#! /bin/bash
cat <<---
This test checks "fancyindex_language auto", which walks the Accept-Language
header in the order given by the client and falls back to English when no
supported language matches.
--

nginx_start 'fancyindex_language auto;'

function fetch_lang () {
	wget -q -O- --header="Accept-Language: $1" \
		"http://localhost:${NGINX_PORT}/" 2>/dev/null
}

function check_lang () {
	local accept=$1 expected=$2 unexpected=$3 content

	content=$(fetch_lang "${accept}")

	if ! grep -qF "${expected}" <<< "${content}" ; then
		fail 'Accept-Language "%s" did not select "%s"\n' \
			"${accept}" "${expected}"
	fi

	if [[ -n ${unexpected} ]] && grep -qF "${unexpected}" <<< "${content}" ; then
		fail 'Accept-Language "%s" unexpectedly produced "%s"\n' \
			"${accept}" "${unexpected}"
	fi
}

# Language prefixes, quality values and region subtags.
check_lang 'zh-CN,zh;q=0.9,en;q=0.8' '文件名称' 'File Name'
check_lang 'en-US,en;q=0.9' 'File Name' '文件名称'
check_lang 'zh-Hans-CN' '文件名称' 'File Name'

# Unsupported languages fall back to English.
check_lang 'fr-FR,fr;q=0.9' 'File Name' '文件名称'

# The header order wins over the quality values.
check_lang 'en-US,zh-CN' 'File Name' '文件名称'
check_lang 'zh-CN,en-US' '文件名称' 'File Name'

# Without an Accept-Language header English is used.
content=$(fetch)
if ! grep -qF 'File Name' <<< "${content}" ; then
	fail 'English is not the fallback when Accept-Language is missing\n'
fi
